# MongoDB connection string. MongoDB must run as a replica set (transactions).
# Local dev: `npm run mongo` starts one on port 27018. MongoDB Atlas works as-is.
DATABASE_URL="mongodb://127.0.0.1:27018/waste_mgmt?replicaSet=rs0&directConnection=true"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:3000"
