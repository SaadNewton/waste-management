{
  "name": "waste-management",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/setup.mjs",
    "dev": "concurrently -n db,api,web -c blue,green,magenta \"npm:dev:db\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:atlas": "concurrently -n api,web -c green,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:db": "npm run mongo --prefix backend",
    "dev:api": "npm run dev --prefix backend",
    "dev:web": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "start": "concurrently -n api,web -c green,magenta \"npm start --prefix backend\" \"npm start --prefix frontend\"",
    "db:push": "npm run db:push --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "lint": "npm run lint --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
